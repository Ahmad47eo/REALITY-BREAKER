; Engine configuration file.
; REALITY BREAKER - Godot 4

config_version=5

[application]
config/name="REALITY BREAKER"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A lightweight first-person gravity puzzle game."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.07, 1)

[physics]
3d/default_gravity=18.0
